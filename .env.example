# GEMINI_API_KEY: Server-side Gemini API key (automatically injected by Google AI Studio).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL for the application.
APP_URL="MY_APP_URL"

# Nebius Token Factory (OpenAI-Compatible Provider — Nebius × NVIDIA Hackathon)
# Default base URL: https://api.tokenfactory.nebius.com/v1
# Supports NVIDIA open-source Nemotron models (e.g., nvidia/Llama-3_1-Nemotron-Ultra-253B-v1) and Qwen/DeepSeek coding models.
NEBIUS_API_KEY=""
NEBIUS_BASE_URL="https://api.tokenfactory.nebius.com/v1"
NEBIUS_MODEL="nvidia/Llama-3_1-Nemotron-Ultra-253B-v1"

# NVIDIA Nemotron / NVIDIA NIM (OpenAI-Compatible Provider)
# Use the exact NVIDIA open-source model ID configured in NVIDIA_MODEL.
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="nvidia/llama-3.1-nemotron-70b-instruct"

# Optional Custom OpenAI-Compatible Endpoint
OPENAI_COMPAT_API_KEY=""
OPENAI_COMPAT_BASE_URL=""
OPENAI_COMPAT_MODEL=""

# Isolated Sandbox Configuration
# Never execute uploaded Python code directly in the web server process or host OS.
# Set SANDBOX_RUNNER_URL to an isolated microVM / gVisor runner endpoint, or
# ENABLE_DOCKER_SANDBOX="true" when an isolated rootless Docker daemon is mounted.
SANDBOX_RUNNER_URL=""
ENABLE_DOCKER_SANDBOX="false"
SANDBOX_DOCKER_IMAGE="python:3.11-slim"
SANDBOX_TIMEOUT_MS="15000"
SANDBOX_MAX_MEMORY_MB="128"
